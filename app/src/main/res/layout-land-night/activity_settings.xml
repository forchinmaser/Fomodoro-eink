<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1F1F"
    android:scrollbars="none"
    tools:context=".SettingsActivity">

    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp"
            android:paddingVertical="15dp">

            <TextView
                android:id="@+id/settings_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/lato_bold"
                android:text="Settings"
                android:textColor="@color/white"
                android:textSize="28sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/timer_settings_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/header"
            android:orientation="vertical">

            <!-- TIMER SETTINGS COMPONENTS -->
            <LinearLayout
                android:id="@+id/timer_settings_components"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- FOCUSED TIME ROW -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/lato_bold"
                        android:text="Focused Time"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/focused_time_minus_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bordered_box_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lato_bold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="−"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/focused_time_value_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:fontFamily="@font/lato_regular"
                            android:gravity="center"
                            android:minWidth="72dp"
                            android:text="25 mins"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/focused_time_plus_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bordered_box_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lato_bold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="+"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- SHORT BREAK ROW -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/lato_bold"
                        android:text="Short Break"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/short_break_minus_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bordered_box_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lato_bold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="−"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/short_break_value_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:fontFamily="@font/lato_regular"
                            android:gravity="center"
                            android:minWidth="72dp"
                            android:text="5 mins"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/short_break_plus_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bordered_box_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lato_bold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="+"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- LONG BREAK ROW -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/lato_bold"
                        android:text="Long Break"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/long_break_minus_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bordered_box_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lato_bold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="−"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/long_break_value_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:fontFamily="@font/lato_regular"
                            android:gravity="center"
                            android:minWidth="72dp"
                            android:text="10 mins"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/long_break_plus_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bordered_box_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lato_bold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="+"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- SESSIONS ROW -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/lato_bold"
                        android:text="Sessions"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/sessions_minus_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bordered_box_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lato_bold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="−"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/sessions_value_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:fontFamily="@font/lato_regular"
                            android:gravity="center"
                            android:minWidth="88dp"
                            android:text="4 sessions"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/sessions_plus_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bordered_box_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lato_bold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="+"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- ALARM ROW -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/lato_bold"
                        android:text="Alarm"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/alarm_minus_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bordered_box_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lato_bold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="−"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/alarm_value_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:fontFamily="@font/lato_regular"
                            android:gravity="center"
                            android:minWidth="72dp"
                            android:text="3 times"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/alarm_plus_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bordered_box_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lato_bold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="+"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- AUTO START SESSIONS ROW -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/lato_bold"
                        android:text="Auto start sessions"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <com.arijit.pomodoro.widgets.EinkToggle
                        android:id="@+id/auto_start_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:inkColor="@color/white"
                        app:surfaceColor="@color/black" />

                </RelativeLayout>

            </LinearLayout>

            <!-- RUNNING TIMER TXT -->
            <TextView
                android:id="@+id/running_timer_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginHorizontal="22dp"
                android:fontFamily="@font/lato_regular"
                android:text="Timer and UI Settings are hidden during an ongoing pomodoro session. Pause the current timer to change the settings. It will reset the timer"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- UI SETTINGS TXT -->
        <TextView
            android:id="@+id/ui_settings_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/timer_settings_placeholder"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="10dp"
            android:visibility="visible"
            android:fontFamily="@font/lato_bold"
            android:text="UI settings"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <View
            android:id="@+id/ui_settings_rule"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@id/ui_settings_txt"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="3dp"
            android:background="@color/white" />

        <!-- UI SETTINGS COMPONENTS -->
        <LinearLayout
            android:id="@+id/ui_settings_components"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:layout_below="@id/ui_settings_rule"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <!-- DARK MODE ROW -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/lato_bold"
                    android:text="Dark mode"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <com.arijit.pomodoro.widgets.EinkToggle
                    android:id="@+id/dark_mode_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:inkColor="@color/white"
                    app:surfaceColor="@color/black" />

            </RelativeLayout>

            <!-- AMOLED ROW -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/lato_bold"
                    android:text="Amoled"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <com.arijit.pomodoro.widgets.EinkToggle
                    android:id="@+id/amoled_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:inkColor="@color/white"
                    app:surfaceColor="@color/black" />

            </RelativeLayout>

            <!-- KEEP SCREEN AWAKE ROW -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/lato_bold"
                    android:text="Keep screen awake"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <com.arijit.pomodoro.widgets.EinkToggle
                    android:id="@+id/keep_screen_awake_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:inkColor="@color/white"
                    app:surfaceColor="@color/black" />

            </RelativeLayout>

            <!-- HAPTIC FEEDBACK ROW -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/lato_bold"
                    android:text="Haptic feedback"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <com.arijit.pomodoro.widgets.EinkToggle
                    android:id="@+id/haptic_feedback_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:inkColor="@color/white"
                    app:surfaceColor="@color/black" />

            </RelativeLayout>

            <!-- ULTRA FOCUS MODE ROW -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/lato_bold"
                    android:text="Ultra focus mode"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <com.arijit.pomodoro.widgets.EinkToggle
                    android:id="@+id/ultra_focus_mode_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:inkColor="@color/white"
                    app:surfaceColor="@color/black" />

            </RelativeLayout>

            <!-- CLOCK SOUND ROW -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/lato_bold"
                    android:text="Clock sound"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <com.arijit.pomodoro.widgets.EinkToggle
                    android:id="@+id/clock_sound_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:inkColor="@color/white"
                    app:surfaceColor="@color/black" />

            </RelativeLayout>

        </LinearLayout>

        <!-- BACKGROUND MUSIC TXT -->
        <TextView
            android:id="@+id/background_music_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ui_settings_components"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="10dp"
            android:visibility="visible"
            android:fontFamily="@font/lato_bold"
            android:text="Background Music"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <View
            android:id="@+id/background_music_rule"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@id/background_music_txt"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="3dp"
            android:background="@color/white" />

        <!-- BACKGROUND MUSIC COMPONENTS -->
        <LinearLayout
            android:id="@+id/background_music_components"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:layout_below="@id/background_music_rule"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <!-- MUSIC ROW -->
            <RelativeLayout
                android:id="@+id/music_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/lato_bold"
                    android:text="Music"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/music_value_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bordered_box_dark"
                    android:fontFamily="@font/lato_bold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Off"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </RelativeLayout>

        </LinearLayout>

        <!-- STATS TXT -->
        <TextView
            android:id="@+id/stats_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/background_music_components"
            android:layout_marginStart="22dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/lato_bold"
            android:text="Stats"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <View
            android:id="@+id/stats_rule"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@id/stats_txt"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="3dp"
            android:background="@color/white" />

        <!-- YOUR STATS ROW -->
        <RelativeLayout
            android:id="@+id/stats_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/stats_rule"
            android:layout_marginHorizontal="22dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/lato_bold"
                android:text="Check your stats"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/stats" />

        </RelativeLayout>

        <!-- ABOUT THE APP TXT -->
        <TextView
            android:id="@+id/about_the_app_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/stats_card"
            android:layout_marginStart="22dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/lato_bold"
            android:text="About the app"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <View
            android:id="@+id/about_the_app_rule"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@id/about_the_app_txt"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="3dp"
            android:background="@color/white" />

        <!-- GITHUB ROW -->
        <RelativeLayout
            android:id="@+id/github_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/about_the_app_rule"
            android:layout_marginHorizontal="22dp"
            android:paddingVertical="6dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/github_icon_bg"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="25dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/medium_red"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/github" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"
                android:layout_toEndOf="@id/github_icon_bg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/gr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:includeFontPadding="false"
                    android:text="Github Repository"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/ri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_regular"
                    android:text="Report issues or star the project"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

            </LinearLayout>

        </RelativeLayout>

        <!-- SUPPORT ROW -->
        <RelativeLayout
            android:id="@+id/support_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/github_card"
            android:layout_marginHorizontal="22dp"
            android:paddingVertical="6dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/support_icon_bg"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="25dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/medium_red"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/paper_cup" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"
                android:layout_toEndOf="@id/support_icon_bg"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:includeFontPadding="false"
                    android:text="Buy me a Coffee"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_regular"
                    android:text="Help me keep building free and open source applications."
                    android:textColor="@color/white"
                    android:textSize="13sp" />

            </LinearLayout>

        </RelativeLayout>

        <!-- MADE WITH LOVE TXT -->
        <TextView
            android:id="@+id/made_with_love_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/support_card"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lato_regular"
            android:text="Made with ❤️ by Arijit"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <!--BLANK SPACE-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_below="@id/made_with_love_txt" />

    </RelativeLayout>

</ScrollView>
