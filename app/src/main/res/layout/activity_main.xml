<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- TOP BAR -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="15dp">

        <!-- MUSIC BUTTON -->
        <ImageView
            android:id="@+id/music_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="ambient music button"
            android:src="@drawable/music_black"
            android:visibility="visible" />

        <!-- MUSIC ANIMATED BUTTON -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/music_animated_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:lottie_rawRes="@raw/music_anim"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:contentDescription="ambient music button"
            android:visibility="gone" />

        <!-- SETTINGS BUTTON -->
        <ImageView
            android:id="@+id/settings_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="settings button"
            android:src="@drawable/settings" />

        <!-- APP TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/lato_bold"
            android:text="Fomodoro"
            android:textColor="@color/black"
            android:textSize="20sp" />

    </RelativeLayout>

    <View
        android:id="@+id/top_bar_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/top_bar"
        android:background="@color/black" />

    <!-- CONTAINER -->
    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar_divider" />

    <!-- SESSIONS COUNT TXT -->
    <TextView
        android:id="@+id/sessions_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lato_regular"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:contentDescription="sessions count"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:text="1 / 4" />

</RelativeLayout>
