<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.ShortBreakFragment">

    <LinearLayout
        android:id="@+id/relative_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- SHORT BREAK CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/focus_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="50dp">

            <LinearLayout
                android:id="@+id/short_break_card_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/medium_green"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/coffee"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/coffee_dark_green" />

                <TextView
                    android:id="@+id/short_break_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/lato_regular"
                    android:text="Short Break"
                    android:textColor="@color/deep_green"
                    android:textSize="16sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- TIMER TXT -->
        <TextView
            android:id="@+id/timer_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_regular"
            android:includeFontPadding="false"
            android:text="24:59"
            android:textColor="@color/light_green"
            android:textSize="144sp" />

        <!-- BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- RESET BUTTON -->
            <ImageView
                android:id="@+id/reset_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/reset_green_dark"
                android:visibility="gone" />

            <!-- PLAY BUTTON -->
            <ImageView
                android:id="@+id/play_btn"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="10dp"
                android:contentDescription="play"
                android:src="@drawable/ic_play_dark"
                android:visibility="visible" />

            <!-- PAUSE BUTTON -->
            <ImageView
                android:id="@+id/pause_btn"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="10dp"
                android:contentDescription="pause"
                android:src="@drawable/ic_pause_dark"
                android:visibility="gone" />

            <!-- SKIP BUTTON -->
            <ImageView
                android:id="@+id/skip_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/skip_green_dark"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- BACK TO TIMER TXT -->
    <TextView
        android:id="@+id/back_to_timer_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/light_green"
        android:textSize="20sp"
        android:layout_below="@id/relative_layout"
        android:layout_centerHorizontal="true"
        android:text="Back to timer"
        android:fontFamily="@font/lato_regular"
        android:layout_marginTop="20dp" />

</RelativeLayout>
